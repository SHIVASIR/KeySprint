# Backend Environment Variables
APP_NAME=KeySprint API
ENVIRONMENT=development
# In production (ENVIRONMENT=production), SECRET_KEY MUST be a unique 32+ char random value
# and COOKIE_SECURE MUST be true (HTTPS). Default placeholder keys are rejected at startup.
SECRET_KEY=dev-insecure-change-me-in-production-keysprint-secret
DATABASE_URL=postgresql+psycopg://keysprint:keysprint@localhost:5432/keysprint
# Optional Redis for multi-worker rate limiting & race coordination:
# REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
