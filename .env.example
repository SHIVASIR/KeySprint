# KeySprint Root Environment Example
# Copy to .env for Docker Compose or local configuration

POSTGRES_DB=keysprint
POSTGRES_USER=keysprint
POSTGRES_PASSWORD=change-me-strong-password

# In production (ENVIRONMENT=production), use a strong 32+ char secret and enable HTTPS + COOKIE_SECURE=true
ENVIRONMENT=development
COOKIE_SECURE=false
BACKEND_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000
